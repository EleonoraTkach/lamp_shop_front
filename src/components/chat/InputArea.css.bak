.inputArea {
  flex-shrink: 0;
  width: 100%;

  display: flex;
  gap: 8px;
  padding: 12px;

  border-top: 1px solid var(--color-border);
  background: var(--color-bg);
}

.inputTextarea {
  flex: 1;
  min-width: 0;

  resize: none;

  padding: 12px 14px;
  border-radius: 12px;

  border: 1px solid var(--color-border);
  background: var(--color-bg);
  color: var(--color-text);

  font-size: 15px;
  line-height: 1.4;

  overflow-y: auto;
}

.inputButton {
  flex-shrink: 0;
  padding: 0 16px;
  border-radius: 8px;
  background: var(--color-primary);
  color: var(--color-primary);
  cursor: pointer;
}

.inputTextarea:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.inputButton:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.inputButton.stop {
  background: #ef4444;
}