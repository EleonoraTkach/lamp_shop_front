import {Message} from "./Message";
import type {MessageProp} from "./Message";
import {TypingIndicator} from "./TypingIndicator";
import "./MessageList.css";

type MessageItem = MessageProp & {
  id: number;
};

type MessageListProp = {
  messages: MessageItem[];
  isLoading: boolean;
  bottomRef: RefObject<HTMLDivElement>;
};

export const MessageList = ({ messages, isLoading , bottomRef}:MessageListProp) => {
  if (!messages.length) {
    return <div>Начните новый диалог</div>;
  }

  return (
    <div className="messageList" style={{ width: '100%' }}>
      {messages.map((msg) => (
        <Message
          key={msg.id}
          role={msg.role}
          text={msg.content}
        />
      ))}
	  <div ref={bottomRef} />
      <TypingIndicator isVisible={isLoading} />
    </div>
  );
};